set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(CMAKE_C_COMPILER clang)
set(CMAKE_CXX_COMPILER clang++)
set(CMAKE_C_COMPILER_TARGET x86_64-unknown-none-elf)
set(CMAKE_CXX_COMPILER_TARGET x86_64-unknown-none-elf)
set(CMAKE_AR ar)
set(CMAKE_RANLIB ranlib)
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES ALOS_SOURCE_DIR)
if(NOT DEFINED ALOS_SOURCE_DIR)
  message(FATAL_ERROR "ALOS_SOURCE_DIR must name the ALOS source checkout")
endif()
set(CMAKE_SYSROOT "${ALOS_SOURCE_DIR}")
set(CMAKE_C_FLAGS_INIT "-D__ALOS__ -ffreestanding -fno-pic -fno-pie -I${ALOS_SOURCE_DIR}/src/userland/libc/include")
set(CMAKE_CXX_FLAGS_INIT "-D__ALOS__ -fhosted -fno-builtin -fno-pic -fno-pie -ftls-model=local-exec -I${ALOS_SOURCE_DIR}/src/userland/libc/include")
