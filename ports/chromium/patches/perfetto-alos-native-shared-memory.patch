diff --git a/src/tracing/ipc/posix_shared_memory.cc b/src/tracing/ipc/posix_shared_memory.cc
index 40fa962..c9af957 100644
--- a/src/tracing/ipc/posix_shared_memory.cc
+++ b/src/tracing/ipc/posix_shared_memory.cc
@@ -20,7 +20,8 @@
     PERFETTO_BUILDFLAG(PERFETTO_OS_ANDROID) || \
     PERFETTO_BUILDFLAG(PERFETTO_OS_APPLE) ||   \
     PERFETTO_BUILDFLAG(PERFETTO_OS_FUCHSIA) || \
-    PERFETTO_BUILDFLAG(PERFETTO_OS_WASM)
+    PERFETTO_BUILDFLAG(PERFETTO_OS_WASM) || \
+    PERFETTO_BUILDFLAG(PERFETTO_OS_ALOS)
 
 #include <fcntl.h>
 #include <stdint.h>
@@ -29,23 +30,36 @@
 #include <sys/mman.h>
 #include <sys/stat.h>
 #include <unistd.h>
+#if PERFETTO_BUILDFLAG(PERFETTO_OS_ALOS)
+#include <sys/alos_shm.h>
+#endif
 
 #include <memory>
 #include <utility>
 
 #include "perfetto/base/compiler.h"
 #include "perfetto/base/logging.h"
+#if !PERFETTO_BUILDFLAG(PERFETTO_OS_ALOS)
 #include "perfetto/ext/base/temp_file.h"
 #include "src/tracing/ipc/memfd.h"
+#endif
 
 namespace perfetto {
 
 namespace {
+#if !PERFETTO_BUILDFLAG(PERFETTO_OS_ALOS)
 int kFileSeals = F_SEAL_SHRINK | F_SEAL_GROW | F_SEAL_SEAL;
+#endif
 }  // namespace
 
 // static
 std::unique_ptr<PosixSharedMemory> PosixSharedMemory::Create(size_t size) {
+#if PERFETTO_BUILDFLAG(PERFETTO_OS_ALOS)
+  if (!size || size > ALOS_SHM_MAX_SIZE) return nullptr;
+  base::ScopedFile fd(alos_shm_create(size));
+  if (!fd) return nullptr;
+  return MapFD(std::move(fd), size);
+#else
   base::ScopedFile fd =
       CreateMemfd("perfetto_shmem", MFD_CLOEXEC | MFD_ALLOW_SEALING);
   bool is_memfd = !!fd;
@@ -72,12 +86,23 @@ std::unique_ptr<PosixSharedMemory> PosixSharedMemory::Create(size_t size) {
   }
 
   return MapFD(std::move(fd), size);
+#endif
 }
 
 // static
 std::unique_ptr<PosixSharedMemory> PosixSharedMemory::AttachToFd(
     base::ScopedFile fd,
     bool require_seals_if_supported) {
+#if PERFETTO_BUILDFLAG(PERFETTO_OS_ALOS)
+  // Native SHM size is immutable; no Linux memfd seals or transport is implied.
+  (void)require_seals_if_supported;
+  long size = alos_shm_size(fd.get());
+  if (size <= 0 || static_cast<size_t>(size) > ALOS_SHM_MAX_SIZE ||
+      alos_shm_access(fd.get()) != O_RDWR) {
+    return nullptr;
+  }
+  return MapFD(std::move(fd), static_cast<size_t>(size));
+#else
   bool requires_seals = require_seals_if_supported;
 
 #if PERFETTO_BUILDFLAG(PERFETTO_ANDROID_BUILD)
@@ -102,6 +127,7 @@ std::unique_ptr<PosixSharedMemory> PosixSharedMemory::AttachToFd(
   int res = fstat(fd.get(), &stat_buf);
   PERFETTO_CHECK(res == 0 && stat_buf.st_size > 0);
   return MapFD(std::move(fd), static_cast<size_t>(stat_buf.st_size));
+#endif
 }
 
 // static
@@ -111,7 +137,11 @@ std::unique_ptr<PosixSharedMemory> PosixSharedMemory::MapFD(base::ScopedFile fd,
   PERFETTO_DCHECK(size > 0);
   void* start =
       mmap(nullptr, size, PROT_READ | PROT_WRITE, MAP_SHARED, fd.get(), 0);
+#if PERFETTO_BUILDFLAG(PERFETTO_OS_ALOS)
+  if (start == MAP_FAILED) return nullptr;
+#else
   PERFETTO_CHECK(start != MAP_FAILED);
+#endif
   return std::unique_ptr<PosixSharedMemory>(
       new PosixSharedMemory(start, size, std::move(fd)));
 }
