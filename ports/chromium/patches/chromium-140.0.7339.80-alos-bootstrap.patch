diff --git a/build/toolchain/alos/BUILD.gn b/build/toolchain/alos/BUILD.gn
new file mode 100644
--- /dev/null
+++ b/build/toolchain/alos/BUILD.gn
@@ -0,0 +1,17 @@
+# Initial ALOS x86-64 bootstrap toolchain. The ALOS sysroot is mounted at
+# /alos and the independently built libc++ headers at /libcxx.
+import("//build/toolchain/gcc_toolchain.gni")
+
+gcc_toolchain("clang_x64") {
+  cc = "clang --target=x86_64-unknown-none-elf -D__ALOS__ -fno-builtin"
+  cxx = "clang++ --target=x86_64-unknown-none-elf -D__ALOS__ -fno-builtin -nostdinc++"
+  ld = cxx
+  ar = "ar"
+  extra_cppflags = "-I/libcxx/include/c++/v1 -I/alos/src/userland/libc/include"
+  extra_ldflags = "-nostdlib -L/libcxx/lib -lc++ -lc++abi -L/alos/src/userland/libc -lc"
+  toolchain_args = {
+    current_cpu = "x64"
+    current_os = "alos"
+    use_remoteexec = false
+  }
+}
