 bool TextContentsEqual(const FilePath& filename1, const FilePath& filename2) {
+#if BUILDFLAG(IS_ALOS)
+  ScopedFILE file1(fopen(filename1.value().c_str(), "r"));
+  ScopedFILE file2(fopen(filename2.value().c_str(), "r"));
+  if (!file1 || !file2) {
+    return false;
+  }
+
+  // Defer CR runs until their following byte is known, without a line-size cap.
+  struct LineReader {
+    FILE* file;
+    size_t carriage_returns = 0;
+    int next = EOF;
+    bool has_next = false;
+    bool failed = false;
+
+    int Read() {
+      if (carriage_returns) {
+        --carriage_returns;
+        return '\r';
+      }
+      if (has_next) {
+        has_next = false;
+        return next;
+      }
+      int c = fgetc(file);
+      while (c == '\r') {
+        if (carriage_returns == std::numeric_limits<size_t>::max()) {
+          failed = true;
+          return EOF;
+        }
+        ++carriage_returns;
+        c = fgetc(file);
+      }
+      if (c == '\n' || c == EOF) {
+        carriage_returns = 0;
+        return c;
+      }
+      if (carriage_returns) {
+        next = c;
+        has_next = true;
+        --carriage_returns;
+        return '\r';
+      }
+      return c;
+    }
+  };
+  LineReader reader1{file1.get()}, reader2{file2.get()};
+  do {
+    int c1, c2;
+    do {
+      c1 = reader1.Read();
+      c2 = reader2.Read();
+      if (reader1.failed || reader2.failed || ferror(file1.get()) ||
+          ferror(file2.get()) || c1 != c2) {
+        return false;
+      }
+    } while (c1 != '\n' && c1 != EOF);
+    if (feof(file1.get()) != feof(file2.get())) {
+      return false;
+    }
+  } while (!feof(file1.get()) || !feof(file2.get()));
+  return true;
+#else
 #if BUILDFLAG(IS_WIN)
   std::ifstream file1(filename1.value().c_str(), std::ios::in);
   std::ifstream file2(filename2.value().c_str(), std::ios::in);
@@ -313,6 +397,7 @@ bool TextContentsEqual(const FilePath& filename1, const FilePath& filename2) {
   } while (!file1.eof() || !file2.eof());
 
   return true;
+#endif
 }
 
