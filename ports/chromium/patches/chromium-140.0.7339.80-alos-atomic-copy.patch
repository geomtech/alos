 #include "base/memory/aligned_memory.h"
 
 namespace base::subtle {
+namespace {
+
+#if BUILDFLAG(IS_ALOS)
+// The pinned libc++ 18 does not provide atomic_ref. These compiler atomics
+// operate on the existing destination objects without changing their ABI.
+static_assert(sizeof(uint8_t) == 1 && alignof(uint8_t) == 1);
+static_assert(sizeof(uintmax_t) == 8 && alignof(uintmax_t) == 8);
+static_assert(__atomic_always_lock_free(sizeof(uint8_t), nullptr));
+static_assert(__atomic_always_lock_free(sizeof(uintmax_t), nullptr));
+constexpr size_t kByteAtomicAlignment = alignof(uint8_t);
+constexpr size_t kWordAtomicAlignment = alignof(uintmax_t);
+
+template <typename T>
+void StoreRelaxed(T* destination, T value) {
+  __atomic_store_n(destination, value, __ATOMIC_RELAXED);
+}
+#else
+constexpr size_t kByteAtomicAlignment =
+    std::atomic_ref<uint8_t>::required_alignment;
+constexpr size_t kWordAtomicAlignment =
+    std::atomic_ref<uintmax_t>::required_alignment;
+
+template <typename T>
+void StoreRelaxed(T* destination, T value) {
+  std::atomic_ref<T>(*destination).store(value, std::memory_order_relaxed);
+}
+#endif
+
+}  // namespace
 
