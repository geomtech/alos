--- /dev/null
+++ b/base/debug/stack_trace_alos.cc
@@ -0,0 +1,104 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "base/debug/stack_trace.h"
+
+#include <stdint.h>
+#include <stdio.h>
+
+#include <ostream>
+
+#include "base/compiler_specific.h"
+
+namespace base::debug {
+
+bool EnableInProcessStackDumping() {
+  fputs("ALOS: signal-driven stack dumping is unavailable; synchronous "
+        "capture records one caller PC only, without unwinding or symbols.\n",
+        stderr);
+  return false;
+}
+
+// ALOS does not walk frame chains: this is one compiler-provided return PC,
+// including when the caller was built with omitted frame pointers.
+NOINLINE size_t CollectStackTrace(span<const void*> trace) {
+  if (trace.empty()) {
+    return 0;
+  }
+  const void* pc =
+      __builtin_extract_return_addr(__builtin_return_address(0));
+  if (!pc) {
+    return 0;
+  }
+  trace[0] = pc;
+  return 1;
+}
+
+void StackTrace::PrintMessageWithPrefix(cstring_view prefix,
+                                       cstring_view message) {
+  fputs(prefix.c_str(), stderr);
+  fputs(message.c_str(), stderr);
+}
+
+void StackTrace::PrintWithPrefixImpl(cstring_view prefix) const {
+  size_t index = 0;
+  for (const void* pc : addresses()) {
+    fprintf(stderr, "%s#%zu 0x%zx\n", prefix.c_str(), index++,
+            reinterpret_cast<uintptr_t>(pc));
+  }
+}
+
+void StackTrace::OutputToStreamWithPrefixImpl(std::ostream* os,
+                                              cstring_view prefix) const {
+  size_t index = 0;
+  for (const void* pc : addresses()) {
+    char line[64];
+    snprintf(line, sizeof(line), "#%zu 0x%zx\n", index++,
+             reinterpret_cast<uintptr_t>(pc));
+    *os << prefix << line;
+  }
+}
+
+namespace internal {
+
+void itoa_r(intptr_t value, int base, size_t padding, span<char> buf) {
+  if (buf.empty()) {
+    return;
+  }
+  buf[0] = '\0';
+  if (base < 2 || base > 16) {
+    return;
+  }
+  uintptr_t magnitude = static_cast<uintptr_t>(value);
+  size_t start = 0;
+  if (value < 0 && base == 10) {
+    magnitude = static_cast<uintptr_t>(-(value + 1)) + 1;
+    if (buf.size() < 2) {
+      return;
+    }
+    buf[start++] = '-';
+  }
+  size_t end = start;
+  constexpr char digits[] = "0123456789abcdef";
+  do {
+    if (end >= buf.size() - 1) {
+      buf[0] = '\0';
+      return;
+    }
+    buf[end++] = digits[magnitude % static_cast<uintptr_t>(base)];
+    magnitude /= static_cast<uintptr_t>(base);
+    if (padding) {
+      --padding;
+    }
+  } while (magnitude || padding);
+  buf[end] = '\0';
+  for (size_t left = start, right = end - 1; left < right; ++left, --right) {
+    char digit = buf[left];
+    buf[left] = buf[right];
+    buf[right] = digit;
+  }
+}
+
+}  // namespace internal
+}  // namespace base::debug
