@@ -682,6 +682,15 @@ template("single_gcc_toolchain") {
       rustc_wrapper =
           rebase_path("//build/rust/gni_impl/rustc_wrapper.py", root_build_dir)
 
+      # Options rustc propres a la toolchain ALOS : modele TLS local-exec (les macros
+      # procedurales hote (.so) ne le supportent pas : R_X86_64_TPOFF32) et lints
+      # plafonnes a warn (la cible n'a pas la famille unix : des crates tierces avec
+      # deny(unused_imports) echoueraient).
+      alos_rustc_extra = ""
+      if (invoker_toolchain_args.current_os == "alos") {
+        alos_rustc_extra = " -Ztls-model=local-exec --cap-lints=warn"
+      }
+
       # RSP manipulation due to https://bugs.chromium.org/p/gn/issues/detail?id=249
       tool("rust_staticlib") {
         libname = "{{output_dir}}/{{target_output_name}}{{output_extension}}"
@@ -699,7 +708,7 @@ template("single_gcc_toolchain") {
