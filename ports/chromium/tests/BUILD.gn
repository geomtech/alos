assert(is_alos, "This executable targets native ALOS only.")

declare_args() {
  alos_build_ozone_probe = false
}

set_defaults("executable") {
  inputs = [
    "/alos/src/userland/libc/crt0.o",
    "/alos/src/userland/libc/libc.a",
    "/alos/src/userland/libm/libm.a",
    "/libcxx/lib/libc++.a",
    "/libcxx/lib/libc++abi.a",
    "/alos/ports/chromium/build/link-native.py",
  ]
}

executable("base_smoke") {
  sources = [ "base-smoke.cc" ]
  deps = [ "//base" ]
}

executable("atomic_smoke") {
  sources = [ "nativeatomic-runtime-test.cc" ]
  deps = [ "//base" ]
}

executable("file_comparison_smoke") {
  sources = [ "nativefile-comparison-test.cc" ]
  deps = [ "//base" ]
}

executable("stack_trace_smoke") {
  sources = [ "base-stack-trace-smoke.cc" ]
  deps = [ "//base" ]
}

group("all") {
  deps = [
    ":base_smoke",
    ":atomic_smoke",
    ":file_comparison_smoke",
    ":stack_trace_smoke",
    ":io_pump_smoke",
    ":process_smoke",
    ":discardable_capability_smoke",
    ":thread_smoke",
    ":elf_reader_smoke",
  ]
}

executable("io_pump_smoke") {
  sources = [ "base-io-pump-smoke.cc" ]
  deps = [ "//base" ]
}

executable("process_smoke") {
  sources = [ "base-process-smoke.cc" ]
  deps = [ "//base" ]
}

executable("discardable_capability_smoke") {
  sources = [ "base-discardable-capability-smoke.cc" ]
  deps = [ "//base" ]
}

executable("thread_smoke") {
  sources = [ "base-thread-smoke.cc" ]
  deps = [ "//base" ]
}

executable("elf_reader_smoke") {
  sources = [ "base-elf-reader-smoke.cc" ]
  deps = [ "//base" ]
}

if (alos_build_ozone_probe) {
  executable("ozone_interface_probe") {
    sources = [ "ozone-interface-probe.cc" ]
    inputs += [ "/alos/src/userland/libgui/libgui.a" ]
    include_dirs = [ "/alos/src/userland/libgui/include" ]
    ldflags = [ "/alos/src/userland/libgui/libgui.a" ]
    deps = [
      "//skia",
      "//ui/gfx/geometry",
      "//ui/ozone",
    ]
  }
}
